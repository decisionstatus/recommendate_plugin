# Backend API Configuration
# URL of the FastAPI backend that provides recommendation engine
API_BASE_URL=https://api.smartcalc.in/api/v1

# Default Store ID
# In development, this is used as the default store ID for API calls
# In production, this should be dynamically set based on the authenticated Shopify session
DEFAULT_STORE_ID=dev-store-1

# Server Configuration
# Port on which the Express server will run
PORT=5000

# Node Environment
# Options: development, production
NODE_ENV=development

# Optional: Database Configuration (if using local database)
# DATABASE_URL=postgresql://user:password@localhost:5432/recommendate

# Optional: Session Secret (for production use with authentication)
# SESSION_SECRET=your-secure-random-session-secret

# Optional: Shopify App Configuration (for production Shopify app)
# SHOPIFY_API_KEY=your-shopify-api-key
# SHOPIFY_API_SECRET=your-shopify-api-secret
# SHOPIFY_SCOPES=read_products,write_products,read_orders
# SHOPIFY_APP_URL=https://your-app-domain.com
